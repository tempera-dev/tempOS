{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-bundle.schema.json",
  "title": "TraceBundle",
  "description": "A self-contained end-to-end trace: the objects for one session run plus its hash-linked receipt and journal chains. Consumed by the conformance gate. final.md §24 (MVP proof), §2.2 (reproducibility).",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "policy_version", "sessions", "manifests", "decisions", "journal"],
  "properties": {
    "bundle_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "policy_version": { "type": "string" },
    "sessions": { "type": "array", "items": { "$ref": "agent-session.schema.json" }, "minItems": 1 },
    "grants": { "type": "array", "items": { "$ref": "capability-grant.schema.json" } },
    "capability_revocations": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability_revocation" },
      "default": []
    },
    "payment_mandates": { "type": "array", "items": { "$ref": "payment-mandate.schema.json" } },
    "approvals": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/approval_evidence" } },
    "simulations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/simulation_evidence" } },
    "manifests": { "type": "array", "items": { "$ref": "action-manifest.schema.json" } },
    "decisions": { "type": "array", "items": { "$ref": "policy-decision.schema.json" } },
    "execution_leases": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/execution_lease" },
      "default": []
    },
    "execution_lease_heartbeats": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/execution_lease_heartbeat" },
      "default": []
    },
    "execution_reconciliations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/execution_lease_reconciliation" },
      "default": []
    },
    "model_route_decisions": {
      "type": "array",
      "items": { "$ref": "journal.schema.json#/$defs/model_route_decision_record" },
      "default": []
    },
    "memory_records": {
      "type": "array",
      "items": { "$ref": "memory-record.schema.json" },
      "default": []
    },
    "scenario_evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario_evaluation" },
      "default": []
    },
    "incident_annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/incident_annotation" },
      "default": []
    },
    "receipts": { "type": "array", "items": { "$ref": "capability-receipt.schema.json" } },
    "journal": { "type": "array", "items": { "$ref": "journal.schema.json" } }
  },
  "$defs": {
    "capability_revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "revocation_handle", "revoked_by", "reason"],
      "properties": {
        "grant_id": { "type": "string", "minLength": 1 },
        "revocation_handle": { "type": "string", "minLength": 1 },
        "revoked_by": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "scenario_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "passed"],
      "properties": {
        "scenario": { "$ref": "scenario-manifest.schema.json" },
        "passed": { "type": "boolean" }
      }
    },
    "incident_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "note"],
      "properties": {
        "incident_id": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    }
  }
}
