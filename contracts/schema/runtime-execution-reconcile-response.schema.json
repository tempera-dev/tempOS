{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-execution-reconcile-response.schema.json",
  "title": "RuntimeExecutionReconcileResponse",
  "description": "HTTP/runtime response after the daemon appends ExecutionLeaseReconciled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "action_id",
    "lease_id",
    "reconciliation_id",
    "resolution",
    "reconciliation_seq",
    "reconciliation_hash",
    "final_journal_root_hash"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "action_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "reconciliation_id": { "type": "string", "minLength": 1 },
    "resolution": { "$ref": "common.schema.json#/$defs/execution_lease_resolution" },
    "reconciliation_seq": { "$ref": "common.schema.json#/$defs/uint" },
    "reconciliation_hash": { "$ref": "common.schema.json#/$defs/hash_value" },
    "final_journal_root_hash": { "$ref": "common.schema.json#/$defs/hash_value" }
  }
}
